{% assign product = section.settings.product %}
{% assign current_variant = product.selected_or_first_available_variant %}

<div class="product-card">
  <div class="product-image">
    <span
      class="sale-badge"
      {% unless current_variant.compare_at_price > current_variant.price %}
        style="display:none;"
      {% endunless %}
    >
      {% if current_variant.compare_at_price > current_variant.price %}
        {% assign zbritje = current_variant.compare_at_price
          | minus: current_variant.price
          | times: 100
          | divided_by: current_variant.compare_at_price
        %}

        -{{ zbritje }} %
      {% endif %}
    </span>
    {% if product.featured_image != blank %}
      <a href="{{ product.url }}">
        {{
          product.featured_image
          | image_url: width: 600
          | image_tag: class: 'product-main-image', alt: product.title
        }}
      </a>
    {% endif %}
  </div>
  <h3>
    <a href="{{ product.url }}">{{ product.title }}</a>
  </h3>
  <span class="product-price">
    {{ current_variant.price | money }}
  </span>
  <span
    class="compare-price"
    {% unless current_variant.compare_at_price > current_variant.price %}
      style="display:none;"
    {% endunless -%}
  >
    >{{ current_variant.compare_at_price | money -}}
  </span>

  <div class="variant-list">
    {% for variant in product.variants %}
      <button
        type="button"
        class="variant-button {% if variant.id == current_variant.id %}active{% endif %}"
        data-variant-id="{{ variant.id }}"
        data-variant-title="{{ variant.title | escape }}"

        data-variant-price="{{ variant.price | money }}"
        data-variant-compare-price="{{ variant.compare_at_price | money }}"
        {% if variant.featured_image != blank %}
          data-variant-image="{{ variant.featured_image | image_url: width: 600  }}"
        {% endif %}
        {%- unless variant.available -%}
          disabled
        {%- endunless -%}
      >
        {{ variant.title }}
      </button>
    {% endfor %}
  </div>

  <input
    type="hidden"
    name="id"
    class="variant-id-input"
    value="{{ current_variant.id }}"
  >
  {% if product.available %}
    <button
      type="button"
      class="add-to-cart-button"
    >
      Add to Cart
    </button>
  {% else %}
    <button
      type="button"
      class="add-to-cart-button"
      disabled
    >
      Sold Out
    </button>
  {% endif %}
  <div class="quantity-selector">
    <button
      type="button"
      class="quantity-minus"
    >
      -
    </button>
    <input
      type="number"
      class="quantity-input"
      value="1"
      min="1"
    >
    <button
      type="button"
      class="quantity-plus"
    >
      +
    </button>
  </div>
  <p class="cart-error"></p>
</div>

<style>
  .product-card {
    width: 300px;
    padding: 20px;
    background: #ffffff;
    border: 1px solid #ddd;
    border-radius: 10px;
  }

  .product-image {
    position: relative;
  }

  .product-card img {
    width: 100%;
    height: auto;
    display: block;
  }

  .sale-badge {
    position: absolute;
    top: 10px;
    left: 10px;

    background: black;
    color: white;

    padding: 6px 10px;
    border-radius: 5px;

    z-index: 2;
  }

  .product-card h3 {
    font-size: 18px;
    font-weight: 500;

    margin-top: 10px;
  }

  .product-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .variant-button {
    width: auto;

    padding: 8px 12px;
    margin: 5px;

    background: white;
    color: black;

    border: 1px solid #ccc;

    cursor: pointer;
  }

  .variant-button.active {
    background: black;
    color: white;
  }

  .variant-button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .add-to-cart-button {
    width: 100%;

    background: black;
    color: white;

    border: none;

    padding: 12px;
    margin-top: 15px;

    cursor: pointer;
  }

  .add-to-cart-button:hover {
    background: #333;
  }

  .add-to-cart-button:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .quantity-selector {
    display: flex;
    align-items: center;

    gap: 8px;

    margin-top: 15px;
  }

  .quantity-selector button {
    width: 40px;
    height: 40px;

    cursor: pointer;
  }

  .quantity-input {
    width: 60px;
    height: 40px;

    text-align: center;
  }
</style>

{% schema %}
{
  "name": "Test1",
  "tag": "section",
  "class": "test-section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "product"
    }
  ],
  "presets": [
    {
      "name": "Test1",
      "settings": {}
    }
  ]
}
{% endschema %}
