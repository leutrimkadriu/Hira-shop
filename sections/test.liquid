{% assign product = section.settings.product %}

<div class="product-card">
  {{ product.featured_image | image_url: width: 600 | image_tag }}

  <h1>{{ product.title }}</h1>
  <p>{{ product.price }}</p>
  <button>Add to Cart</button>
</div>

{% schema %}
{
  "name": "Test1",
  "tag": "section",
  "class": "test-section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "product"
    }
  ],
  "presets": [
    {
      "name": "Test1",
      "settings": {}
    }
  ]
}
{% endschema %}
