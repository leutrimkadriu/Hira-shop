          "default": "<p>Super comfortable and lightweight. I would definitely recommend them.</p>"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "September 2026"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Customer reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "author": "Diana",
            "rating": 5,
            "verified": true,
            "title": "Very comfortable",
            "body": "<p>Very soft and comfortable. Great for everyday wear.</p>"
          }
        },
        {
          "type": "review",
          "settings": {
            "author": "Anna",
            "rating": 5,
            "verified": true,
            "title": "Love them",
            "body": "<p>Lightweight and very comfortable. The fit is perfect.</p>"
          }
        },
        {
          "type": "review",
          "settings": {
            "author": "Mia",
            "rating": 4,
            "verified": true,
            "title": "Good quality",
            "body": "<p>Comfortable and easy to wear. I am happy with the purchase.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}