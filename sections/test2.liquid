{% assign product = section.settings.product %}

{% if product.featured_image %}
  {{ product.featured_image | image_url: width: 1200 | image_tag: product.title }}
{% endif %}

<h1>{{ product.title }}</h1>
<p>{{ product.price | money }}</p>

{% schema %}
{
  "name": "Test2",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    }
  ],
  "presets": [
    {
      "name": "Test2"
    }
  ]
}
{% endschema %}
