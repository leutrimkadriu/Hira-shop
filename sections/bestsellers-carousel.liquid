{% assign selected_collection = section.settings.collection %}

<section
  id="Bestsellers-{{ section.id }}"
  class="bestsellers"
>
  <div class="bestsellers__container">

    {% if section.settings.heading != blank %}
      <h2 class="bestsellers__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}


    {% if selected_collection != blank and selected_collection.products.size > 0 %}

      <div class="bestsellers__slider">

        <div
          class="bestsellers__track"
          data-bestsellers-track
        >

          {% for product in selected_collection.products limit: section.settings.products_to_show %}

            {% assign current_variant = product.selected_or_first_available_variant %}

            <article class="bestsellers__card">

              <!-- ========================================
                   PRODUCT IMAGE
              ========================================= -->

              <div class="bestsellers__media">

                {% if section.settings.badge_text != blank %}
                  <span class="bestsellers__badge">
                    {{ section.settings.badge_text }}
                  </span>
                {% endif %}


                <a
                  href="{{ product.url }}"
                  class="bestsellers__image-link"
                  aria-label="{{ product.title | escape }}"
                >

                  {% if product.featured_image != blank %}

                    {{
                      product.featured_image
                      | image_url: width: 1000
                      | image_tag:
                        loading: 'lazy',
                        widths: '300, 450, 600, 750, 900, 1000',
                        sizes: '(min-width: 1200px) 23vw, (min-width: 750px) 42vw, 78vw',
                        class: 'bestsellers__image'
                    }}

                  {% else %}

                    {{ 'product-1' | placeholder_svg_tag: 'bestsellers__placeholder' }}

                  {% endif %}

                </a>

              </div>


              <!-- ========================================
                   PRODUCT INFO
              ========================================= -->

              <div class="bestsellers__info">

                <a
                  href="{{ product.url }}"
                  class="bestsellers__title"
                >
                  {{ product.title }}
                </a>


                <!-- PRICE -->

                <div class="bestsellers__price-row">

                  <span class="bestsellers__price">
                    {{ current_variant.price | money }}
                  </span>


                  {% if current_variant.compare_at_price > current_variant.price %}

                    <s class="bestsellers__compare">
                      {{ current_variant.compare_at_price | money }}
                    </s>


                    {% assign discount_amount = current_variant.compare_at_price
                      | minus: current_variant.price
                    %}

                    {% assign discount_percentage = discount_amount
                      | times: 100.0
                      | divided_by: current_variant.compare_at_price
                      | round
                    %}


                    <span class="bestsellers__discount">
                      -{{ discount_percentage }}%
                    </span>

                  {% endif %}

                </div>


                <!-- ========================================
                     RELATED COLORS
                ========================================= -->

                {% assign related_colors = product.metafields.custom.related_colors.value %}

                {% if related_colors != blank %}

                  <div class="bestsellers__colors">

                    {% for color_product in related_colors limit: 6 %}

                      <button
  type="button"
  class="bestsellers__color{% if color_product.id == product.id %} is-active{% endif %}"
  title="{{ color_product.title | escape }}"
  aria-label="{{ color_product.title | escape }}"
  data-color-swatch
  data-image="{{ color_product.featured_image | image_url: width: 1000 }}"
>

                        {% if color_product.featured_image != blank %}

                          {{
                            color_product.featured_image
                            | image_url: width: 80
                            | image_tag:
                              loading: 'lazy',
                              class: 'bestsellers__color-image'
                          }}

                        {% endif %}

                      </button>

                    {% endfor %}


                    {% if related_colors.size > 6 %}

                      <span class="bestsellers__more">
                        +{{ related_colors.size | minus: 6 }}
                      </span>

                    {% endif %}

                  </div>

                {% endif %}

              </div>

            </article>

          {% endfor %}

        </div>


        <!-- ========================================
             CONTROLS
        ========================================= -->

        <div class="bestsellers__controls">

          <div class="bestsellers__arrows">

            <button
              type="button"
              class="bestsellers__arrow"
              data-bestsellers-prev
              aria-label="Previous products"
            >
              ←
            </button>

            <button
              type="button"
              class="bestsellers__arrow"
              data-bestsellers-next
              aria-label="Next products"
            >
              →
            </button>

          </div>


          <div class="bestsellers__progress">
            <span
              class="bestsellers__progress-bar"
              data-bestsellers-progress
            ></span>
          </div>

        </div>

      </div>

    {% else %}

      <div class="bestsellers__empty">
        Select a collection.
      </div>

    {% endif %}


    <!-- ========================================
         BOTTOM HEADING
    ========================================= -->

    {% if section.settings.bottom_heading != blank %}

      <div class="bestsellers__bottom-content">

        <h2 class="bestsellers__bottom-heading">
          {{ section.settings.bottom_heading }}
        </h2>


        {% if section.settings.bottom_text != blank %}

          <div class="bestsellers__bottom-text">
            {{ section.settings.bottom_text }}
          </div>

        {% endif %}

      </div>

    {% endif %}

  </div>
</section>



<style>

/* ============================================================
   SECTION
============================================================ */

#Bestsellers-{{ section.id }} {
  width: 100%;

  padding:
    {{ section.settings.padding_top }}px
    0
    {{ section.settings.padding_bottom }}px;

  background:
    {{ section.settings.background }};

  color:
    {{ section.settings.text_color }};

  overflow: hidden;
}


#Bestsellers-{{ section.id }} * {
  box-sizing: border-box;
}


/* ============================================================
   CONTAINER
============================================================ */

#Bestsellers-{{ section.id }} .bestsellers__container {
  width: 100%;

  max-width: 1400px;

  margin: 0 auto;

  padding: 0 20px;
}


/* ============================================================
   HEADING
============================================================ */

#Bestsellers-{{ section.id }} .bestsellers__heading {
  margin:
    0
    0
    28px;

  font-size:
    clamp(28px, 3vw, 40px);

  line-height: 1;

  font-weight: 600;

  letter-spacing: -.035em;
}


/* ============================================================
   SLIDER
============================================================ */

#Bestsellers-{{ section.id }} .bestsellers__track {
  display: grid;

  grid-auto-flow: column;

  /*
    Kjo e bën afërsisht:
    4 produkte të plota
    + një pjesë të produktit të pestë
  */

  grid-auto-columns: 23.5%;

  gap: 12px;

  overflow-x: auto;

  overflow-y: hidden;

  scroll-behavior: smooth;

  scroll-snap-type: x mandatory;

  overscroll-behavior-inline: contain;

  scrollbar-width: none;
}


#Bestsellers-{{ section.id }} .bestsellers__track::-webkit-scrollbar {
  display: none;
}


/* ============================================================
   CARD
============================================================ */

#Bestsellers-{{ section.id }} .bestsellers__card {
  min-width: 0;

  scroll-snap-align: start;
}


/* ============================================================
   MEDIA
============================================================ */

#Bestsellers-{{ section.id }} .bestsellers__media {
  position: relative;

  width: 100%;

  aspect-ratio: 1 / 1;

  overflow: hidden;

  background: #f7f7f7;
}


#Bestsellers-{{ section.id }} .bestsellers__image-link {
  display: block;

  width: 100%;
  height: 100%;
}


#Bestsellers-{{ section.id }} .bestsellers__image {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: contain;

  transition:
    transform .35s ease;
}


#Bestsellers-{{ section.id }}
.bestsellers__image-link:hover
.bestsellers__image {
  transform: scale(1.025);
}


#Bestsellers-{{ section.id }} .bestsellers__placeholder {
  width: 100%;
  height: 100%;
}


/* ============================================================
   BADGE
============================================================ */

#Bestsellers-{{ section.id }} .bestsellers__badge {
  position: absolute;

  top: 10px;
  left: 10px;

  z-index: 2;

  display: inline-flex;

  align-items: center;

  min-height: 29px;

  padding: 4px 11px;

  background:
    {{ section.settings.badge_background }};

  color:
    {{ section.settings.badge_text_color }};

  font-size: 13px;

  line-height: 1;

  font-weight: 600;
}


/* ============================================================
   INFO
============================================================ */

#Bestsellers-{{ section.id }} .bestsellers__info {
  padding-top: 12px;
}


/* TITLE */

#Bestsellers-{{ section.id }} .bestsellers__title {
  display: inline-block;

  margin-bottom: 6px;

  color: inherit;

  font-size: 15px;

  line-height: 1.2;

  font-weight: 600;

  text-decoration: none;
}


#Bestsellers-{{ section.id }} .bestsellers__title:hover {
  text-decoration: underline;
}


/* ============================================================
   PRICE
============================================================ */

#Bestsellers-{{ section.id }} .bestsellers__price-row {
  display: flex;

  align-items: center;

  flex-wrap: wrap;

  gap: 5px;
}


#Bestsellers-{{ section.id }} .bestsellers__price {
  color:
    {{ section.settings.sale_price_color }};

  font-size: 14px;

  font-weight: 600;
}


#Bestsellers-{{ section.id }} .bestsellers__compare {
  color: #878787;

  font-size: 13px;

  font-weight: 400;
}


#Bestsellers-{{ section.id }} .bestsellers__discount {
  display: inline-flex;

  align-items: center;

  min-height: 21px;

  padding: 2px 5px;

  border: 1px solid #d1ad6f;

  color: #a47d3a;

  font-size: 11px;
}


/* ============================================================
   COLORS
============================================================ */

#Bestsellers-{{ section.id }} .bestsellers__colors {
  display: flex;

  align-items: center;

  gap: 5px;

  min-height: 25px;

  margin-top: 9px;
}


#Bestsellers-{{ section.id }} .bestsellers__color {
  display: block;

  width: 22px;
  height: 22px;

  flex: 0 0 22px;

  padding: 1px;

  border:
    1px solid transparent;

  border-radius: 50%;

  overflow: hidden;

  background: #fff;
}


#Bestsellers-{{ section.id }} .bestsellers__color:hover,
#Bestsellers-{{ section.id }} .bestsellers__color.is-active {
  border-color: #111;
}


#Bestsellers-{{ section.id }} .bestsellers__color-image {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  border-radius: 50%;
}


#Bestsellers-{{ section.id }} .bestsellers__more {
  color: #aaa;

  font-size: 11px;
}


/* ============================================================
   CONTROLS
============================================================ */

#Bestsellers-{{ section.id }} .bestsellers__controls {
  display: flex;

  align-items: center;

  gap: 28px;

  margin-top: 17px;
}


#Bestsellers-{{ section.id }} .bestsellers__arrows {
  display: flex;

  align-items: center;

  gap: 5px;
}


#Bestsellers-{{ section.id }} .bestsellers__arrow {
  width: 38px;
  height: 38px;

  display: flex;

  align-items: center;
  justify-content: center;

  padding: 0;

  border: 0;

  background: transparent;

  color: #111;

  font-size: 25px;

  line-height: 1;

  cursor: pointer;

  transition:
    opacity .2s ease;
}


#Bestsellers-{{ section.id }} .bestsellers__arrow:hover {
  opacity: .55;
}


/* ============================================================
   PROGRESS
============================================================ */

#Bestsellers-{{ section.id }} .bestsellers__progress {
  position: relative;

  width: 275px;

  height: 2px;

  overflow: hidden;

  background: #ccc;
}


#Bestsellers-{{ section.id }} .bestsellers__progress-bar {
  position: absolute;

  top: 0;
  left: 0;

  display: block;

  width: 30%;
  height: 100%;

  background: #111;

  transform-origin: left center;
}


/* ============================================================
   BOTTOM CONTENT
============================================================ */

#Bestsellers-{{ section.id }} .bestsellers__bottom-content {
  margin-top:
    {{ section.settings.bottom_spacing }}px;
}


#Bestsellers-{{ section.id }} .bestsellers__bottom-heading {
  max-width: 1000px;

  margin: 0 0 22px;

  font-size:
    clamp(40px, 4.5vw, 64px);

  line-height: 1;

  font-weight: 500;

  letter-spacing: -.04em;
}


#Bestsellers-{{ section.id }} .bestsellers__bottom-text {
  max-width: 800px;

  font-size: 16px;

  line-height: 1.45;
}


#Bestsellers-{{ section.id }} .bestsellers__bottom-text p {
  margin: 0;
}


/* ============================================================
   EMPTY
============================================================ */

#Bestsellers-{{ section.id }} .bestsellers__empty {
  padding: 50px;

  text-align: center;

  background: #f7f7f7;
}


/* ============================================================
   TABLET
============================================================ */

@media screen and (max-width: 1100px) {

  #Bestsellers-{{ section.id }} .bestsellers__track {
    grid-auto-columns: 42%;
  }

}


/* ============================================================
   MOBILE
============================================================ */

@media screen and (max-width: 700px) {

  #Bestsellers-{{ section.id }} {
    padding:
      {{ section.settings.mobile_padding_top }}px
      0
      {{ section.settings.mobile_padding_bottom }}px;
  }


  #Bestsellers-{{ section.id }} .bestsellers__container {
    padding: 0 14px;
  }


  #Bestsellers-{{ section.id }} .bestsellers__heading {
    margin-bottom: 20px;

    font-size: 28px;
  }


  #Bestsellers-{{ section.id }} .bestsellers__track {
    /*
      1 card e plotë
      + duket pjesë e card-it tjetër
    */

    grid-auto-columns: 78%;

    gap: 8px;
  }


  #Bestsellers-{{ section.id }} .bestsellers__badge {
    top: 8px;
    left: 8px;

    min-height: 27px;

    padding: 4px 9px;

    font-size: 11px;
  }


  #Bestsellers-{{ section.id }} .bestsellers__title {
    font-size: 14px;
  }


  #Bestsellers-{{ section.id }} .bestsellers__controls {
    gap: 15px;

    margin-top: 14px;
  }


  #Bestsellers-{{ section.id }} .bestsellers__progress {
    flex: 1;

    width: auto;
  }


  #Bestsellers-{{ section.id }} .bestsellers__bottom-content {
    margin-top: 55px;
  }


  #Bestsellers-{{ section.id }} .bestsellers__bottom-heading {
    margin-bottom: 15px;

    font-size: 40px;
  }


  #Bestsellers-{{ section.id }} .bestsellers__bottom-text {
    font-size: 15px;
  }

}

</style>



<script>
document.addEventListener('DOMContentLoaded', function () {

  const section =
    document.getElementById(
      'Bestsellers-{{ section.id }}'
    );

  if (!section) return;


  const track =
    section.querySelector(
      '[data-bestsellers-track]'
    );

  const previousButton =
    section.querySelector(
      '[data-bestsellers-prev]'
    );

  const nextButton =
    section.querySelector(
      '[data-bestsellers-next]'
    );

  const progressBar =
    section.querySelector(
      '[data-bestsellers-progress]'
    );


  if (!track) return;



  /* =========================================================
     CARD WIDTH
  ========================================================= */

  function getCardScrollAmount() {

    const card =
      track.querySelector(
        '.bestsellers__card'
      );

    if (!card) {
      return 300;
    }


    const styles =
      window.getComputedStyle(
        track
      );


    const gap =
      parseFloat(
        styles.columnGap ||
        styles.gap ||
        0
      );


    return card.offsetWidth + gap;

  }



  /* =========================================================
     PREVIOUS
  ========================================================= */

  if (previousButton) {

    previousButton.addEventListener(
      'click',
      function () {

        track.scrollBy({
          left:
            -getCardScrollAmount(),

          behavior:
            'smooth'
        });

      }
    );

  }



  /* =========================================================
     NEXT
  ========================================================= */

  if (nextButton) {

    nextButton.addEventListener(
      'click',
      function () {

        track.scrollBy({
          left:
            getCardScrollAmount(),

          behavior:
            'smooth'
        });

      }
    );

  }



  /* =========================================================
     PROGRESS BAR
  ========================================================= */

  function updateProgress() {

    if (!progressBar) return;


    const scrollWidth =
      track.scrollWidth;


    const visibleWidth =
      track.clientWidth;


    const maxScroll =
      scrollWidth -
      visibleWidth;


    if (
      scrollWidth <= 0 ||
      visibleWidth <= 0
    ) {
      return;
    }


    /*
      Sa % e carousel-it është
      aktualisht e dukshme.
    */

    const visiblePercentage =
      Math.min(
        100,
        Math.max(
          10,
          (visibleWidth / scrollWidth) * 100
        )
      );


    progressBar.style.width =
      visiblePercentage + '%';


    if (maxScroll <= 0) {

      progressBar.style.left =
        '0%';

      return;
    }


    const scrollPercentage =
      track.scrollLeft /
      maxScroll;


    const availableMovement =
      100 -
      visiblePercentage;


    progressBar.style.left =
      (
        scrollPercentage *
        availableMovement
      ) + '%';

  }



  track.addEventListener(
    'scroll',
    updateProgress,
    {
      passive: true
    }
  );


  window.addEventListener(
    'resize',
    updateProgress
  );

const colorSwatches =
  section.querySelectorAll('[data-color-swatch]');

colorSwatches.forEach(function (swatch) {

  swatch.addEventListener('click', function () {

    const card =
      swatch.closest('.bestsellers__card');

    if (!card) return;

    const mainImage =
      card.querySelector('.bestsellers__image');

    if (!mainImage) return;

    const newImage =
      swatch.dataset.image;

    if (!newImage) return;

    mainImage.src = newImage;

    mainImage.removeAttribute('srcset');

    card
      .querySelectorAll('[data-color-swatch]')
      .forEach(function (item) {
        item.classList.remove('is-active');
      });

    swatch.classList.add('is-active');

  });

});
  updateProgress();

});
</script>



{% schema %}
{
  "name": "Bestsellers carousel",

  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "HEading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 10
    },

    {
      "type": "header",
      "content": "Sale badge"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Final Summer Sale"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Badge background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text",
      "default": "#ffffff"
    },

    {
      "type": "header",
      "content": "Bottom content"
    },
    {
      "type": "text",
      "id": "bottom_heading",
      "label": "Bottom heading",
      "default": "Welcome to our universe"
    },
    {
      "type": "richtext",
      "id": "bottom_text",
      "label": "Bottom text",
      "default": "<p>This is how our community styles their favorites!</p>"
    },
    {
      "type": "range",
      "id": "bottom_spacing",
      "label": "Space before bottom heading",
      "min": 20,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 75
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "sale_price_color",
      "label": "Sale price",
      "default": "#e51c00"
    },

    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top spacing",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 55
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom spacing",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 55
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 45
    }
  ],

  "presets": [
    {
      "name": "Bestsellers carousel"
    }
  ]
}
{% endschema %}