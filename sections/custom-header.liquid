{% liquid
  assign is_home = false

  if request.page_type == 'index'
    assign is_home = true
  endif
%}

<header
  id="CustomHeader-{{ section.id }}"
  class="custom-header{% if is_home %} custom-header--overlay{% endif %}"
  data-custom-header
>

  <!-- ======================================================
       ANNOUNCEMENT BAR
  ======================================================= -->
  {% if section.settings.show_announcement %}
    <div class="custom-header__announcement">

      <div class="custom-header__announcement-inner">

        <div class="custom-header__announcement-space"></div>

        <div class="custom-header__announcement-center">

          {% if section.settings.announcement_text != blank %}
            <span class="custom-header__announcement-text">
              {{ section.settings.announcement_text }}
            </span>
          {% endif %}


          {% if section.settings.announcement_link_text != blank %}
            <a
              href="{{ section.settings.announcement_link | default: routes.root_url }}"
              class="custom-header__announcement-link"
            >
              {{ section.settings.announcement_link_text }}
            </a>
          {% endif %}

        </div>


        {% if section.settings.country_text != blank %}
          <div class="custom-header__country">

            <svg
              class="custom-header__globe"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle
                cx="12"
                cy="12"
                r="9"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
              />

              <path
                d="M3 12h18M12 3c2.7 2.5 4 5.5 4 9s-1.3 6.5-4 9c-2.7-2.5-4-5.5-4-9s1.3-6.5 4-9Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
              />
            </svg>

            <span>
              {{ section.settings.country_text }}
            </span>

          </div>
        {% endif %}

      </div>

    </div>
  {% endif %}


  <!-- ======================================================
       MAIN HEADER
  ======================================================= -->
  <div
    class="custom-header__main"
    data-main-header
  >

    <div class="custom-header__inner">

      <!-- LOGO -->
      <div class="custom-header__logo">

        <a
          href="{{ routes.root_url }}"
          class="custom-header__logo-link"
          aria-label="{{ shop.name | escape }}"
        >

          {% if section.settings.logo != blank %}

            {{
              section.settings.logo
              | image_url: width: 500
              | image_tag:
                loading: 'eager',
                widths: '120, 180, 240, 320, 400, 500',
                class: 'custom-header__logo-image'
            }}

          {% else %}

            <span class="custom-header__logo-text">
              {{ shop.name }}
            </span>

          {% endif %}

        </a>

      </div>


      <!-- ==================================================
           DESKTOP NAVIGATION
      =================================================== -->
      <nav
        class="custom-header__nav"
        aria-label="Main navigation"
      >

        {% if section.settings.menu != blank %}

          {% for link in section.settings.menu.links %}

            <div class="custom-header__nav-item">

              <a
                href="{{ link.url }}"
                class="custom-header__nav-link"
              >
                {{ link.title }}
              </a>


              {% if link.links != blank %}

                <div class="custom-header__dropdown">

                  {% for child_link in link.links %}

                    <div class="custom-header__dropdown-item">

                      <a
                        href="{{ child_link.url }}"
                        class="custom-header__dropdown-link"
                      >
                        {{ child_link.title }}
                      </a>


                      {% if child_link.links != blank %}

                        <div class="custom-header__dropdown-grandchildren">

                          {% for grandchild_link in child_link.links %}

                            <a
                              href="{{ grandchild_link.url }}"
                              class="custom-header__dropdown-grandchild"
                            >
                              {{ grandchild_link.title }}
                            </a>

                          {% endfor %}

                        </div>

                      {% endif %}

                    </div>

                  {% endfor %}

                </div>

              {% endif %}

            </div>

          {% endfor %}

        {% endif %}

      </nav>


      <!-- ==================================================
           ACTIONS
      =================================================== -->
      <div class="custom-header__actions">

        <!-- SEARCH -->
        <a
          href="{{ routes.search_url }}"
          class="custom-header__icon-link custom-header__search"
          aria-label="Search"
        >

          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle
              cx="10.5"
              cy="10.5"
              r="6.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            />

            <path
              d="m15.5 15.5 4.5 4.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>

        </a>


        <!-- ACCOUNT -->
        {% if shop.customer_accounts_enabled %}

          <a
            href="{{ routes.account_url }}"
            class="custom-header__icon-link custom-header__account"
            aria-label="Account"
          >

            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
            >

              <circle
                cx="12"
                cy="7.5"
                r="3.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              />

              <path
                d="M5.5 21c.4-4 2.9-6.4 6.5-6.4S18.1 17 18.5 21"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
              />

            </svg>

          </a>

        {% endif %}


        <!-- CART -->
        <a
          href="{{ routes.cart_url }}"
          class="custom-header__icon-link custom-header__cart"
          aria-label="Cart"
        >

          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
          >

            <path
              d="M6.5 8.5h11l-.8 11H7.3l-.8-11Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            />

            <path
              d="M9 8.5V6.7A3 3 0 0 1 12 3.5a3 3 0 0 1 3 3.2v1.8"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />

          </svg>


          <span
            class="custom-header__cart-count"
            data-cart-count
          >
            {{ cart.item_count }}
          </span>

        </a>


        <!-- MOBILE MENU BUTTON -->
        <button
          type="button"
          class="custom-header__menu-button"
          data-mobile-menu-button
          aria-label="Open menu"
          aria-expanded="false"
        >

          <span></span>
          <span></span>
          <span></span>

        </button>

      </div>

    </div>

  </div>


  <!-- ======================================================
       MOBILE DRAWER
  ======================================================= -->
  <div
    class="custom-header__mobile-overlay"
    data-mobile-overlay
  ></div>


  <div
    class="custom-header__mobile-menu"
    data-mobile-menu
    aria-hidden="true"
  >

    <div class="custom-header__mobile-top">

      <span class="custom-header__mobile-logo">
        {{ shop.name }}
      </span>

      <button
        type="button"
        class="custom-header__mobile-close"
        data-mobile-close
        aria-label="Close menu"
      >
        ×
      </button>

    </div>


    <div class="custom-header__mobile-menu-inner">

      {% if section.settings.menu != blank %}

        {% for link in section.settings.menu.links %}

          <div class="custom-header__mobile-item">

            <div class="custom-header__mobile-row">

              <a
                href="{{ link.url }}"
                class="custom-header__mobile-main-link"
              >
                {{ link.title }}
              </a>


              {% if link.links != blank %}

                <button
                  type="button"
                  class="custom-header__mobile-toggle"
                  data-mobile-submenu-toggle
                  aria-expanded="false"
                  aria-label="Open {{ link.title | escape }}"
                >
                  +
                </button>

              {% endif %}

            </div>


            {% if link.links != blank %}

              <div
                class="custom-header__mobile-children"
                data-mobile-submenu
              >

                {% for child_link in link.links %}

                  <a href="{{ child_link.url }}">
                    {{ child_link.title }}
                  </a>

                  {% if child_link.links != blank %}

                    {% for grandchild_link in child_link.links %}

                      <a
                        href="{{ grandchild_link.url }}"
                        class="custom-header__mobile-grandchild"
                      >
                        {{ grandchild_link.title }}
                      </a>

                    {% endfor %}

                  {% endif %}

                {% endfor %}

              </div>

            {% endif %}

          </div>

        {% endfor %}

      {% endif %}

    </div>


    <div class="custom-header__mobile-bottom">

      <a href="{{ routes.search_url }}">
        Search
      </a>

      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}">
          Account
        </a>
      {% endif %}

    </div>

  </div>

</header>


<style>

/* ============================================================
   IMPORTANT
   Mos vendos position:absolute/fixed te .custom-header wrapper.
============================================================ */

#CustomHeader-{{ section.id }} {
  position: relative;

  width: 100%;

  z-index: 1000;

  font-family: inherit;
}


/* ============================================================
   ANNOUNCEMENT BAR
============================================================ */

#CustomHeader-{{ section.id }} .custom-header__announcement {
  position: relative;

  z-index: 1003;

  width: 100%;

  min-height: 38px;

  display: flex;

  align-items: center;

  background: #000;

  color: #fff;
}


#CustomHeader-{{ section.id }} .custom-header__announcement-inner {
  width: 100%;

  max-width: 1400px;

  min-height: 38px;

  margin: 0 auto;

  padding: 0 20px;

  display: grid;

  grid-template-columns: 1fr auto 1fr;

  align-items: center;

  gap: 20px;
}


#CustomHeader-{{ section.id }} .custom-header__announcement-center {
  display: flex;

  align-items: center;

  justify-content: center;

  gap: 18px;

  font-size: 12px;

  line-height: 1.2;
}


#CustomHeader-{{ section.id }} .custom-header__announcement-link {
  color: inherit;

  text-decoration: underline;

  text-underline-offset: 2px;
}


#CustomHeader-{{ section.id }} .custom-header__country {
  justify-self: end;

  display: flex;

  align-items: center;

  gap: 6px;

  font-size: 12px;
}


#CustomHeader-{{ section.id }} .custom-header__globe {
  width: 16px;
  height: 16px;
}


/* ============================================================
   MAIN HEADER — DEFAULT FOR NON-HOME PAGES
============================================================ */

#CustomHeader-{{ section.id }} .custom-header__main {
  position: relative;

  z-index: 1002;

  width: 100%;

  background:
    {{ section.settings.scrolled_background }};

  color:
    {{ section.settings.scrolled_text_color }};

  transition:
    background .25s ease,
    color .25s ease,
    box-shadow .25s ease;
}


/* ============================================================
   HOME PAGE:
   header overlays the hero and does NOT create extra height
============================================================ */

#CustomHeader-{{ section.id }}.custom-header--overlay
.custom-header__main {
  position: absolute;

  top:
    {% if section.settings.show_announcement %}
      38px
    {% else %}
      0
    {% endif %};

  left: 0;
  right: 0;

  background:
    rgba(
      0,
      0,
      0,
      {{ section.settings.header_overlay | divided_by: 100.0 }}
    );

  color:
    {{ section.settings.header_text_color }};
}


/* ============================================================
   STICKY / SCROLLED
============================================================ */

#CustomHeader-{{ section.id }}
.custom-header__main.is-scrolled {
  position: fixed !important;

  top: 0 !important;

  left: 0;
  right: 0;

  z-index: 1100;

  background:
    {{ section.settings.scrolled_background }} !important;

  color:
    {{ section.settings.scrolled_text_color }} !important;

  box-shadow:
    0 1px 8px rgba(0,0,0,.08);
}


/* ============================================================
   INNER HEADER
============================================================ */

#CustomHeader-{{ section.id }} .custom-header__inner {
  width: 100%;

  max-width: 1400px;

  min-height: 64px;

  margin: 0 auto;

  padding: 0 20px;

  display: grid;

  grid-template-columns: minmax(180px, 1fr) auto minmax(180px, 1fr);

  align-items: center;

  gap: 30px;
}


/* ============================================================
   LOGO
============================================================ */

#CustomHeader-{{ section.id }} .custom-header__logo {
  justify-self: start;

  min-width: 0;
}


#CustomHeader-{{ section.id }} .custom-header__logo-link {
  display: inline-flex;

  align-items: center;

  color: inherit;

  text-decoration: none;
}


#CustomHeader-{{ section.id }} .custom-header__logo-image {
  display: block;

  width:
    {{ section.settings.logo_width }}px;

  max-width: 100%;

  height: auto;
}


#CustomHeader-{{ section.id }} .custom-header__logo-text {
  color: inherit;

  font-size: 29px;

  line-height: 1;

  font-weight: 600;

  letter-spacing: -.035em;

  white-space: nowrap;
}


/* ============================================================
   DESKTOP NAVIGATION
============================================================ */

#CustomHeader-{{ section.id }} .custom-header__nav {
  justify-self: center;

  display: flex;

  align-items: stretch;

  gap: 34px;

  height: 64px;
}


#CustomHeader-{{ section.id }} .custom-header__nav-item {
  position: relative;

  display: flex;

  align-items: center;
}


#CustomHeader-{{ section.id }} .custom-header__nav-link {
  display: flex;

  align-items: center;

  height: 100%;

  color: inherit;

  font-size: 14px;

  line-height: 1;

  text-decoration: none;

  white-space: nowrap;

  transition: opacity .18s ease;
}


#CustomHeader-{{ section.id }} .custom-header__nav-link:hover {
  opacity: .65;
}


/* ============================================================
   DROPDOWN
============================================================ */

#CustomHeader-{{ section.id }} .custom-header__dropdown {
  position: absolute;

  top: 100%;
  left: 50%;

  transform:
    translate(-50%, 8px);

  min-width: 210px;

  padding: 8px 0;

  border: 1px solid #e7e7e7;

  background: #fff;

  color: #111;

  box-shadow:
    0 12px 30px rgba(0,0,0,.08);

  opacity: 0;

  visibility: hidden;

  pointer-events: none;

  transition:
    opacity .18s ease,
    transform .18s ease,
    visibility .18s ease;
}


#CustomHeader-{{ section.id }}
.custom-header__nav-item:hover
.custom-header__dropdown,
#CustomHeader-{{ section.id }}
.custom-header__nav-item:focus-within
.custom-header__dropdown {
  transform:
    translate(-50%, 0);

  opacity: 1;

  visibility: visible;

  pointer-events: auto;
}


#CustomHeader-{{ section.id }} .custom-header__dropdown-link {
  display: block;

  padding: 10px 16px;

  color: #111;

  font-size: 13px;

  text-decoration: none;
}


#CustomHeader-{{ section.id }} .custom-header__dropdown-link:hover {
  background: #f6f6f6;
}


#CustomHeader-{{ section.id }} .custom-header__dropdown-grandchildren {
  padding:
    0
    16px
    8px;
}


#CustomHeader-{{ section.id }} .custom-header__dropdown-grandchild {
  display: block;

  padding: 5px 8px;

  color: #777;

  font-size: 12px;

  text-decoration: none;
}


/* ============================================================
   ACTIONS / ICONS
============================================================ */

#CustomHeader-{{ section.id }} .custom-header__actions {
  justify-self: end;

  display: flex;

  align-items: center;

  gap: 17px;
}


#CustomHeader-{{ section.id }} .custom-header__icon-link {
  position: relative;

  display: flex;

  align-items: center;
  justify-content: center;

  width: 21px;
  height: 21px;

  color: inherit;

  text-decoration: none;
}


#CustomHeader-{{ section.id }} .custom-header__icon-link svg {
  display: block;

  width: 100%;
  height: 100%;
}


#CustomHeader-{{ section.id }} .custom-header__cart-count {
  position: absolute;

  top: -8px;
  right: -10px;

  min-width: 17px;
  height: 17px;

  padding: 0 4px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 20px;

  background: #fff;

  color: #111;

  box-shadow:
    0 0 0 1px rgba(0,0,0,.08);

  font-size: 9px;

  line-height: 1;
}


/* ============================================================
   MOBILE BUTTON
============================================================ */

#CustomHeader-{{ section.id }} .custom-header__menu-button {
  display: none;

  position: relative;

  z-index: 1201;

  width: 27px;
  height: 27px;

  padding: 4px;

  border: 0;

  background: transparent;

  color: inherit;

  cursor: pointer;
}


#CustomHeader-{{ section.id }} .custom-header__menu-button span {
  display: block;

  width: 100%;
  height: 1px;

  margin: 5px 0;

  background: currentColor;
}


/* ============================================================
   MOBILE OVERLAY
============================================================ */

#CustomHeader-{{ section.id }} .custom-header__mobile-overlay {
  position: fixed;

  inset: 0;

  z-index: 1198;

  background:
    rgba(0,0,0,.3);

  opacity: 0;

  visibility: hidden;

  pointer-events: none;

  transition:
    opacity .25s ease,
    visibility .25s ease;
}


#CustomHeader-{{ section.id }}
.custom-header__mobile-overlay.is-open {
  opacity: 1;

  visibility: visible;

  pointer-events: auto;
}


/* ============================================================
   MOBILE DRAWER
============================================================ */

#CustomHeader-{{ section.id }} .custom-header__mobile-menu {
  position: fixed;

  top: 0;
  right: 0;
  bottom: 0;

  z-index: 1200;

  width: min(90vw, 390px);

  display: flex;

  flex-direction: column;

  background: #fff;

  color: #111;

  box-shadow:
    -8px 0 30px rgba(0,0,0,.08);

  transform:
    translateX(105%);

  visibility: hidden;

  transition:
    transform .3s ease,
    visibility .3s ease;
}


#CustomHeader-{{ section.id }}
.custom-header__mobile-menu.is-open {
  transform:
    translateX(0);

  visibility: visible;
}


#CustomHeader-{{ section.id }} .custom-header__mobile-top {
  min-height: 68px;

  padding: 0 18px;

  display: flex;

  align-items: center;
  justify-content: space-between;

  border-bottom: 1px solid #eee;
}


#CustomHeader-{{ section.id }} .custom-header__mobile-logo {
  font-size: 22px;

  font-weight: 600;
}


#CustomHeader-{{ section.id }} .custom-header__mobile-close {
  width: 36px;
  height: 36px;

  padding: 0;

  border: 0;

  background: transparent;

  color: #111;

  font-size: 30px;

  font-weight: 300;

  line-height: 1;

  cursor: pointer;
}


#CustomHeader-{{ section.id }} .custom-header__mobile-menu-inner {
  flex: 1;

  overflow-y: auto;

  padding: 15px 20px;
}


#CustomHeader-{{ section.id }} .custom-header__mobile-item {
  border-bottom: 1px solid #eee;
}


#CustomHeader-{{ section.id }} .custom-header__mobile-row {
  min-height: 58px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 15px;
}


#CustomHeader-{{ section.id }} .custom-header__mobile-main-link {
  color: #111;

  font-size: 19px;

  text-decoration: none;
}


#CustomHeader-{{ section.id }} .custom-header__mobile-toggle {
  width: 38px;
  height: 38px;

  border: 0;

  background: transparent;

  color: #111;

  font-size: 22px;

  cursor: pointer;
}


#CustomHeader-{{ section.id }} .custom-header__mobile-children {
  display: none;

  padding:
    0
    0
    15px
    12px;
}


#CustomHeader-{{ section.id }}
.custom-header__mobile-children.is-open {
  display: grid;

  gap: 10px;
}


#CustomHeader-{{ section.id }} .custom-header__mobile-children a {
  color: #555;

  font-size: 14px;

  text-decoration: none;
}


#CustomHeader-{{ section.id }} .custom-header__mobile-grandchild {
  padding-left: 12px;

  color: #888 !important;

  font-size: 13px !important;
}


#CustomHeader-{{ section.id }} .custom-header__mobile-bottom {
  padding: 18px 20px;

  display: flex;

  gap: 20px;

  border-top: 1px solid #eee;
}


#CustomHeader-{{ section.id }} .custom-header__mobile-bottom a {
  color: #111;

  font-size: 13px;

  text-decoration: none;
}


/* ============================================================
   MOBILE
============================================================ */

@media screen and (max-width: 800px) {

  #CustomHeader-{{ section.id }}
  .custom-header__announcement-inner {
    grid-template-columns: 1fr;

    min-height: 36px;

    padding: 0 12px;

    justify-items: center;
  }


  #CustomHeader-{{ section.id }}
  .custom-header__announcement-space,
  #CustomHeader-{{ section.id }}
  .custom-header__country {
    display: none;
  }


  #CustomHeader-{{ section.id }}
  .custom-header__announcement {
    min-height: 36px;
  }


  #CustomHeader-{{ section.id }}
  .custom-header__announcement-center {
    min-height: 36px;

    gap: 10px;

    font-size: 11px;

    text-align: center;
  }


  #CustomHeader-{{ section.id }}.custom-header--overlay
  .custom-header__main {
    top:
      {% if section.settings.show_announcement %}
        36px
      {% else %}
        0
      {% endif %};
  }


  #CustomHeader-{{ section.id }}
  .custom-header__inner {
    grid-template-columns:
      minmax(0, 1fr)
      auto;

    min-height: 58px;

    padding: 0 14px;

    gap: 15px;
  }


  #CustomHeader-{{ section.id }}
  .custom-header__nav {
    display: none;
  }


  #CustomHeader-{{ section.id }}
  .custom-header__actions {
    gap: 14px;
  }


  #CustomHeader-{{ section.id }}
  .custom-header__logo-text {
    font-size: 25px;
  }


  #CustomHeader-{{ section.id }}
  .custom-header__logo-image {
    max-width: 120px;
  }


  #CustomHeader-{{ section.id }}
  .custom-header__account {
    display: none;
  }


  #CustomHeader-{{ section.id }}
  .custom-header__menu-button {
    display: block;
  }

}

</style>


<script>
document.addEventListener('DOMContentLoaded', function () {

  const header =
    document.getElementById(
      'CustomHeader-{{ section.id }}'
    );

  if (!header) return;


  const mainHeader =
    header.querySelector(
      '[data-main-header]'
    );

  const mobileMenu =
    header.querySelector(
      '[data-mobile-menu]'
    );

  const mobileOverlay =
    header.querySelector(
      '[data-mobile-overlay]'
    );

  const menuButton =
    header.querySelector(
      '[data-mobile-menu-button]'
    );

  const closeButton =
    header.querySelector(
      '[data-mobile-close]'
    );


  /* ========================================================
     STICKY HEADER
  ======================================================== */

  function updateHeader() {

    if (!mainHeader) return;


    /*
      Home:
      fillimisht transparent mbi hero.
      Pas scroll-it bëhet fixed dhe i bardhë.

      Faqet tjera:
      header normal i bardhë.
    */

    if (
      header.classList.contains(
        'custom-header--overlay'
      ) &&
      window.scrollY > 70
    ) {

      mainHeader.classList.add(
        'is-scrolled'
      );

    } else {

      mainHeader.classList.remove(
        'is-scrolled'
      );

    }

  }


  window.addEventListener(
    'scroll',
    updateHeader,
    {
      passive: true
    }
  );


  updateHeader();


  /* ========================================================
     MOBILE MENU
  ======================================================== */

  function openMenu() {

    if (!mobileMenu) return;


    mobileMenu.classList.add(
      'is-open'
    );


    if (mobileOverlay) {

      mobileOverlay.classList.add(
        'is-open'
      );

    }


    if (menuButton) {

      menuButton.setAttribute(
        'aria-expanded',
        'true'
      );

    }


    mobileMenu.setAttribute(
      'aria-hidden',
      'false'
    );


    document.documentElement.style.overflow =
      'hidden';

  }


  function closeMenu() {

    if (!mobileMenu) return;


    mobileMenu.classList.remove(
      'is-open'
    );


    if (mobileOverlay) {

      mobileOverlay.classList.remove(
        'is-open'
      );

    }


    if (menuButton) {

      menuButton.setAttribute(
        'aria-expanded',
        'false'
      );

    }


    mobileMenu.setAttribute(
      'aria-hidden',
      'true'
    );


    document.documentElement.style.overflow =
      '';

  }


  if (menuButton) {

    menuButton.addEventListener(
      'click',
      openMenu
    );

  }


  if (closeButton) {

    closeButton.addEventListener(
      'click',
      closeMenu
    );

  }


  if (mobileOverlay) {

    mobileOverlay.addEventListener(
      'click',
      closeMenu
    );

  }


  document.addEventListener(
    'keydown',
    function (event) {

      if (event.key === 'Escape') {

        closeMenu();

      }

    }
  );


  /* ========================================================
     MOBILE SUBMENUS
  ======================================================== */

  const submenuButtons =
    header.querySelectorAll(
      '[data-mobile-submenu-toggle]'
    );


  submenuButtons.forEach(
    function (button) {

      button.addEventListener(
        'click',
        function () {

          const item =
            this.closest(
              '.custom-header__mobile-item'
            );

          if (!item) return;


          const submenu =
            item.querySelector(
              '[data-mobile-submenu]'
            );

          if (!submenu) return;


          const open =
            submenu.classList.toggle(
              'is-open'
            );


          this.setAttribute(
            'aria-expanded',
            open ? 'true' : 'false'
          );


          this.textContent =
            open ? '−' : '+';

        }
      );

    }
  );


  /* ========================================================
     CART COUNT
  ======================================================== */

  document.addEventListener(
    'custom-cart-updated',
    function (event) {

      const count =
        header.querySelector(
          '[data-cart-count]'
        );


      if (
        count &&
        event.detail &&
        event.detail.cart
      ) {

        count.textContent =
          event.detail.cart.item_count;

      }

    }
  );

});
</script>


