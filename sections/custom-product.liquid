<script>
  document.addEventListener('DOMContentLoaded', function () {
    const section = document.getElementById('CustomProduct-{{ section.id }}');

    if (!section) return;

    /* ============================================================
     VARIANTS
  ============================================================ */

    const variantJson = section.querySelector('[data-product-variants]');

    const variants = JSON.parse(variantJson.textContent);

    const variantInput = section.querySelector('[data-variant-input]');

    const price = section.querySelector('[data-product-price]');

    const comparePrice = section.querySelector('[data-compare-price]');

    const discount = section.querySelector('[data-discount]');

    const stock = section.querySelector('[data-stock-text]');

    const addButton = section.querySelector('[data-add-to-cart]');

    const addText = section.querySelector('[data-add-text]');

    const addStock = section.querySelector('[data-add-stock]');

    const selectedColorText = section.querySelector('[data-selected-color]');

    const selectedSizeText = section.querySelector('[data-selected-size]');

    const currency =
      window.Shopify && Shopify.currency && Shopify.currency.active
        ? Shopify.currency.active
        : '{{ cart.currency.iso_code | default: shop.currency }}';

    function formatMoney(cents) {
      return new Intl.NumberFormat(document.documentElement.lang || 'en', {
        style: 'currency',
        currency: currency,
      }).format(Number(cents) / 100);
    }

    /* ============================================================
     CURRENT OPTIONS
  ============================================================ */

    const selectedOptions = {};

    section.querySelectorAll('[data-option-button].is-active').forEach(function (button) {
      selectedOptions[button.dataset.optionPosition] = button.dataset.optionValue;
    });

    /* ============================================================
     FIND VARIANT
  ============================================================ */

    function findVariant() {
      return variants.find(function (variant) {
        if (selectedOptions[1] && variant.option1 !== selectedOptions[1]) {
          return false;
        }

        if (selectedOptions[2] && variant.option2 !== selectedOptions[2]) {
          return false;
        }

        if (selectedOptions[3] && variant.option3 !== selectedOptions[3]) {
          return false;
        }

        return true;
      });
    }

    /* ============================================================
     UPDATE VARIANT
  ============================================================ */

    function updateVariant() {
      const variant = findVariant();

      if (!variant) {
        variantInput.value = '';

        addButton.disabled = true;

        addText.textContent = 'UNAVAILABLE';

        return;
      }

      variantInput.value = variant.id;

      price.textContent = formatMoney(variant.price);

      const normalPrice = Number(variant.price || 0);

      const compare = Number(variant.compare_at_price || 0);

      if (compare > normalPrice) {
        comparePrice.textContent = formatMoney(compare);

        comparePrice.classList.remove('is-hidden');

        const percentage = Math.round(((compare - normalPrice) / compare) * 100);

        discount.textContent = '-' + percentage + '%';

        discount.classList.remove('is-hidden');
      } else {
        comparePrice.textContent = '';

        comparePrice.classList.add('is-hidden');

        discount.textContent = '';

        discount.classList.add('is-hidden');
      }

      if (variant.available) {
        stock.textContent = 'In stock';

        addButton.disabled = false;

        addText.textContent = 'ADD TO CART';

        addStock.innerHTML = '<span class="custom-product__green-dot"></span> IN STOCK';
      } else {
        stock.textContent = 'Sold out';

        addButton.disabled = true;

        addText.textContent = 'SOLD OUT';

        addStock.innerHTML = '';
      }
    }

    /* ============================================================
     GALLERY
  ============================================================ */

    const mediaItems = Array.from(section.querySelectorAll('[data-media-item]'));

    const thumbnails = Array.from(section.querySelectorAll('[data-thumbnail]'));

    const previous = section.querySelector('[data-prev-media]');

    const next = section.querySelector('[data-next-media]');

    let visibleMedia = [];

    let currentMediaIndex = 0;

    function showMedia(index) {
      if (!visibleMedia.length) return;

      if (index < 0) {
        index = visibleMedia.length - 1;
      }

      if (index >= visibleMedia.length) {
        index = 0;
      }

      currentMediaIndex = index;

      mediaItems.forEach(function (item) {
        item.classList.remove('is-active');
      });

      thumbnails.forEach(function (thumbnail) {
        thumbnail.classList.remove('is-active');
      });

      const activeItem = visibleMedia[index];

      if (activeItem) {
        activeItem.item.classList.add('is-active');

        if (activeItem.thumbnail) {
          activeItem.thumbnail.classList.add('is-active');
        }
      }
    }

    function updateGallery(color) {
      if (!color) return;

      const normalized = color.toLowerCase().trim();

      visibleMedia = [];

      mediaItems.forEach(function (item) {
        const itemColor = (item.dataset.color || '').toLowerCase().trim();

        const matches = itemColor === normalized;

        item.style.display = matches ? '' : 'none';

        if (matches) {
          const index = mediaItems.indexOf(item);

          visibleMedia.push({
            item: item,

            thumbnail: thumbnails[index],
          });
        }
      });

      thumbnails.forEach(function (thumbnail) {
        const thumbnailColor = (thumbnail.dataset.color || '').toLowerCase().trim();

        thumbnail.style.display = thumbnailColor === normalized ? '' : 'none';
      });

      /*
      Nëse nuk ka ALT që përputhet,
      mos e lë gallery bosh.
    */

      if (!visibleMedia.length) {
        visibleMedia = mediaItems.map(function (item, index) {
          item.style.display = '';

          if (thumbnails[index]) {
            thumbnails[index].style.display = '';
          }

          return {
            item: item,

            thumbnail: thumbnails[index],
          };
        });
      }

      showMedia(0);
    }

    thumbnails.forEach(function (thumbnail, index) {
      thumbnail.addEventListener('click', function () {
        const visibleIndex = visibleMedia.findIndex(function (media) {
          return media.thumbnail === thumbnail;
        });

        if (visibleIndex !== -1) {
          showMedia(visibleIndex);
        }
      });
    });

    if (previous) {
      previous.addEventListener('click', function () {
        showMedia(currentMediaIndex - 1);
      });
    }

    if (next) {
      next.addEventListener('click', function () {
        showMedia(currentMediaIndex + 1);
      });
    }

    /* ============================================================
     OPTION BUTTONS
  ============================================================ */

    const optionButtons = section.querySelectorAll('[data-option-button]');

    optionButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        const position = Number(this.dataset.optionPosition);

        const value = this.dataset.optionValue;

        selectedOptions[position] = value;

        section.querySelectorAll('[data-option-position="' + position + '"]').forEach(function (otherButton) {
          otherButton.classList.remove('is-active');
        });

        this.classList.add('is-active');

        if (this.hasAttribute('data-color')) {
          if (selectedColorText) {
            selectedColorText.textContent = value;
          }

          updateGallery(value);
        }

        if (this.hasAttribute('data-size-button')) {
          if (selectedSizeText) {
            selectedSizeText.textContent = value;
          }
        }

        updateVariant();

        updateSizeAvailability();
      });
    });

    /* ============================================================
     SIZE AVAILABILITY
  ============================================================ */

    function updateSizeAvailability() {
      const sizeButtons = section.querySelectorAll('[data-size-button]');

      sizeButtons.forEach(function (button) {
        const position = Number(button.dataset.optionPosition);

        const temporaryOptions = {
          ...selectedOptions,
          [position]: button.dataset.optionValue,
        };

        const variant = variants.find(function (variant) {
          if (temporaryOptions[1] && variant.option1 !== temporaryOptions[1]) {
            return false;
          }

          if (temporaryOptions[2] && variant.option2 !== temporaryOptions[2]) {
            return false;
          }

          if (temporaryOptions[3] && variant.option3 !== temporaryOptions[3]) {
            return false;
          }

          return true;
        });

        button.classList.toggle('is-sold-out', !variant || !variant.available);
      });
    }

    /* ============================================================
     QUANTITY
  ============================================================ */

    const quantityInput = section.querySelector('[data-quantity-input]');

    const quantityValue = section.querySelector('[data-quantity-value]');

    const quantityPlus = section.querySelector('[data-quantity-plus]');

    const quantityMinus = section.querySelector('[data-quantity-minus]');

    let quantity = 1;

    function updateQuantity() {
      quantityInput.value = quantity;

      quantityValue.textContent = quantity;
    }

    quantityPlus.addEventListener('click', function () {
      quantity++;

      updateQuantity();
    });

    quantityMinus.addEventListener('click', function () {
      if (quantity > 1) {
        quantity--;

        updateQuantity();
      }
    });

    /* ============================================================
     ADD TO CART AJAX
  ============================================================ */

    const form = section.querySelector('.custom-product__form');

    const message = section.querySelector('[data-product-message]');

    form.addEventListener('submit', async function (event) {
      event.preventDefault();

      const variantId = Number(variantInput.value);

      if (!variantId) {
        message.textContent = 'Please select an available variant.';

        message.className = 'custom-product__message is-error';

        return;
      }

      addButton.disabled = true;

      addText.textContent = 'ADDING...';

      try {
        const response = await fetch(window.Shopify.routes.root + 'cart/add.js', {
          method: 'POST',

          headers: {
            'Content-Type': 'application/json',

            Accept: 'application/json',
          },

          body: JSON.stringify({
            items: [
              {
                id: variantId,

                quantity: quantity,
              },
            ],
          }),
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.description || data.message || 'Could not add product');
        }

        addText.textContent = 'ADDED ✓';

        message.textContent = 'Added to cart';

        message.className = 'custom-product__message is-success';

        setTimeout(function () {
          updateVariant();
        }, 1200);
      } catch (error) {
        message.textContent = error.message;

        message.className = 'custom-product__message is-error';

        updateVariant();
      }
    });

    /* ============================================================
     INITIAL STATE
  ============================================================ */

    const initialColor = section.querySelector('[data-color].is-active');

    if (initialColor) {
      updateGallery(initialColor.dataset.optionValue);
    } else {
      /*
      fallback
    */

      visibleMedia = mediaItems.map(function (item, index) {
        return {
          item: item,
          thumbnail: thumbnails[index],
        };
      });

      showMedia(0);
    }

    updateVariant();

    updateSizeAvailability();
  });
</script>

{% schema %}
{
  "name": "Custom product",
  "settings": [],
  "presets": [
    {
      "name": "Custom product"
    }
  ]
}
{% endschema %}
