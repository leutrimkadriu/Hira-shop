{% assign selected_product = product %}

{% if selected_product != blank %}
  {% assign current_variant = selected_product.selected_or_first_available_variant %}
{% endif %}

<section
  id="CustomProduct-{{ section.id }}"
  class="custom-product"
  data-section-id="{{ section.id }}"
>
  {% if selected_product != blank %}
    <div class="custom-product__container">
      <!--
        =====================================================
             LEFT - PRODUCT GALLERY
        ======================================================
      -->

      <div class="custom-product__media">
        <div
          class="custom-product__main-media"
          data-main-media
        >
          {% for media in selected_product.media %}
            {% if media.media_type == 'image' %}
              <div
                class="custom-product__media-item"
                data-media-item
                data-color="{{ media.alt | downcase | strip | escape }}"
              >
                {{
                  media
                  | image_url: width: 1600
                  | image_tag:
                    loading: 'lazy',
                    widths: '600, 900, 1200, 1600',
                    sizes: '(min-width: 990px) 65vw, 100vw',
                    class: 'custom-product__image',
                    alt: media.alt
                }}
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <!-- THUMBNAILS -->

        <div class="custom-product__media-bottom">
          <div
            class="custom-product__thumbnails"
            data-thumbnails
          >
            {% for media in selected_product.media %}
              {% if media.media_type == 'image' %}
                <button
                  type="button"
                  class="custom-product__thumbnail"
                  data-thumbnail
                  data-color="{{ media.alt | downcase | strip | escape }}"
                  data-media-id="{{ media.id }}"
                  aria-label="View image {{ forloop.index }}"
                >
                  {{
                    media.preview_image
                    | image_url: width: 150
                    | image_tag: loading: 'lazy', class: 'custom-product__thumbnail-image', alt: ''
                  }}
                </button>
              {% endif %}
            {% endfor %}
          </div>

          <div class="custom-product__arrows">
            <button
              type="button"
              class="custom-product__arrow"
              data-prev-media
              aria-label="Previous image"
            >
              ←
            </button>

            <button
              type="button"
              class="custom-product__arrow"
              data-next-media
              aria-label="Next image"
            >
              →
            </button>
          </div>
        </div>
      </div>

      <!--
        =====================================================
             RIGHT - PRODUCT INFO
        ======================================================
      -->

      <div class="custom-product__info">
        <!-- TITLE -->
        <div class="custom-product__title-row">
          <h1 class="custom-product__title">
            {{ selected_product.title }}
          </h1>

          {% assign product_badge = selected_product.metafields.custom.product_badge.value %}

          {% if product_badge != blank %}
            <span class="custom-product__title-badge">
              {{ product_badge }}
            </span>
          {% endif %}
        </div>

        <!-- PRICE -->

        <div class="custom-product__price-row">
          <span
            class="custom-product__price"
            data-product-price
          >
            {{ current_variant.price | money }}
          </span>

          <s
            class="
              custom-product__compare-price
              {% unless current_variant.compare_at_price > current_variant.price %}
                is-hidden
              {% endunless %}
            "
            data-compare-price
          >
            {% if current_variant.compare_at_price > current_variant.price %}
              {{ current_variant.compare_at_price | money }}
            {% endif %}
          </s>

          <span
            class="
              custom-product__discount
              {% unless current_variant.compare_at_price > current_variant.price %}
                is-hidden
              {% endunless %}
            "
            data-discount
          >
            {% if current_variant.compare_at_price > current_variant.price %}
              {% assign discount_value = current_variant.compare_at_price | minus: current_variant.price %}

              {% assign discount_percent = discount_value
                | times: 100.0
                | divided_by: current_variant.compare_at_price
                | round
              %}

              -{{ discount_percent }}%
            {% endif %}
          </span>
        </div>

        <!-- STOCK -->

        <div class="custom-product__stock-block">
          <div class="custom-product__stock-line">
            <span class="custom-product__stock-fill"></span>
          </div>

          <div
            class="custom-product__stock-text"
            data-stock-text
          >
            {% if current_variant.available %}
              In stock
            {% else %}
              Sold out
            {% endif %}
          </div>
        </div>

        <!-- DESCRIPTION -->

        <div class="custom-product__description">
          {{ selected_product.description }}
        </div>

        <!--
          =====================================================
               COLOR
          ======================================================
        -->

        {% for option in selected_product.options_with_values %}
          {% if option.name == 'Color' or option.name == 'Colour' %}
            <div class="custom-product__colors">
              <div class="custom-product__option-title">
                <strong>Color:</strong>

                <span data-selected-color>
                  {{ option.selected_value }}
                </span>
              </div>

              <div class="custom-product__color-list">
                {% for value in option.values %}
                  <button
                    type="button"

                    class="
                      custom-product__color
                      {% if value == option.selected_value %}
                        is-active
                      {% endif %}
                    "

                    data-option-button
                    data-option-position="{{ option.position }}"
                    data-option-value="{{ value | escape }}"
                    data-color="{{ value | downcase | strip | escape }}"
                  >
                    {% assign color_variant = null %}

                    {% for variant in selected_product.variants %}
                      {% if variant.option1 == value or variant.option2 == value or variant.option3 == value %}
                        {% assign color_variant = variant %}
                        {% break %}
                      {% endif %}
                    {% endfor %}

                    {% if color_variant != null and color_variant.featured_image != blank %}
                      {{
                        color_variant.featured_image
                        | image_url: width: 100
                        | image_tag: class: 'custom-product__color-image', loading: 'lazy', alt: value
                      }}

                    {% else %}
                      <span
                        class="custom-product__color-fallback"
                        style="background: {{ value | downcase }};"
                      ></span>
                    {% endif %}
                  </button>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        {% endfor %}

        <!--
          =====================================================
               SIZE
          ======================================================
        -->

        {% for option in selected_product.options_with_values %}
          {% if option.name == 'Size' or option.name == 'Shoe size' %}
            <div class="custom-product__sizes">
              <div class="custom-product__size-top">
                <div class="custom-product__option-title">
                  <strong>Size:</strong>

                  <span data-selected-size>
                    {{ option.selected_value }}
                  </span>
                </div>

                <button
                  type="button"
                  class="custom-product__size-chart"
                >
                  Size Chart
                </button>
              </div>

              <div class="custom-product__fit">
                <div class="custom-product__fit-title">How this model fits:</div>

                <div class="custom-product__fit-line">
                  <span class="custom-product__fit-track"></span>
                  <span class="custom-product__fit-selected"></span>
                </div>

                <div class="custom-product__fit-labels">
                  <span>Smaller</span>
                  <span>Perfect fit</span>
                  <span>Larger</span>
                </div>
              </div>

              <div class="custom-product__size-list">
                {% for value in option.values %}
                  <button
                    type="button"

                    class="
                      custom-product__size-button
                      {% if value == option.selected_value %}
                        is-active
                      {% endif %}
                    "

                    data-option-button
                    data-size-button

                    data-option-position="{{ option.position }}"
                    data-option-value="{{ value | escape }}"
                  >
                    {{ value }}
                  </button>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        {% endfor %}

        <!--
          =====================================================
               VARIANT JSON
          ======================================================
        -->

        <script
          type="application/json"
          data-product-variants
        >
          [
            {% for variant in selected_product.variants %}

              {
                "id": {{ variant.id | json }},
                "option1": {{ variant.option1 | json }},
                "option2": {{ variant.option2 | json }},
                "option3": {{ variant.option3 | json }},
                "price": {{ variant.price | json }},
                "compare_at_price": {{ variant.compare_at_price | default: 0 | json }},
                "available": {{ variant.available | json }}
              }

              {% unless forloop.last %}
                ,
              {% endunless %}

            {% endfor %}
          ]
        </script>

        <!--
          =====================================================
               PRODUCT FORM
          ======================================================
        -->

        {% assign product_form_id = 'CustomProductForm-' | append: section.id %}

        {% form 'product', selected_product, id: product_form_id, class: 'custom-product__form' %}
          <input
            type="hidden"
            name="id"
            value="{{ current_variant.id }}"
            data-variant-input
          >

          <input
            type="hidden"
            name="quantity"
            value="1"
            data-quantity-input
          >

          <!-- QUANTITY -->

          <div class="custom-product__quantity">
            <button
              type="button"
              data-quantity-minus
            >
              −
            </button>

            <span data-quantity-value> 1 </span>

            <button
              type="button"
              data-quantity-plus
            >
              +
            </button>
          </div>

          <!-- ADD TO CART -->

          <button
            type="submit"
            class="custom-product__add"
            data-add-to-cart
            {% unless current_variant.available %}
              disabled
            {% endunless %}
          >
            <span data-add-text>
              {% if current_variant.available %}
                ADD TO CART
              {% else %}
                SOLD OUT
              {% endif %}
            </span>

            <small data-add-stock>
              {% if current_variant.available %}
                <span class="custom-product__green-dot"></span>
                IN STOCK
              {% endif %}
            </small>
          </button>

          <div
            class="custom-product__message"
            data-product-message
            aria-live="polite"
          ></div>
        {% endform %}
      </div>
    </div>

  {% else %}
    <div class="custom-product__empty">This section is intended for product templates.</div>
  {% endif %}
</section>

