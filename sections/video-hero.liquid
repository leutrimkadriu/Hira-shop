<section
  id="HeroMedia-{{ section.id }}"
  class="hero-media-section"
>
  <div class="hero-media-section__inner">

    {% if section.settings.video != blank %}

      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          class: 'hero-media-section__video'
      }}

    {% elsif section.settings.image_picker != blank %}

      {{
        section.settings.image_picker
        | image_url: width: 2400
        | image_tag:
          class: 'hero-media-section__image',
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1000, 1400, 1800, 2200, 2400',
          sizes: '100vw'
      }}

    {% endif %}


    <div class="hero-media-section__overlay"></div>


    <div class="hero-media-section__content">

      {% if section.settings.heading != blank %}
        <h2 class="hero-media-section__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}


      {% if section.settings.text != blank %}
        <p class="hero-media-section__text">
          {{ section.settings.text }}
        </p>
      {% endif %}


      {% if section.settings.button_text != blank %}
        <a
          class="hero-media-section__button"
          href="{{ section.settings.button_link | default: '#' }}"
        >
          {{ section.settings.button_text }}
        </a>
      {% endif %}

    </div>

  </div>
</section>


<style>

  /* ============================================================
     SECTION
  ============================================================ */

 #HeroMedia-{{ section.id }} .hero-media-section__inner {
  position: relative;
  width: 100%;

  height: 600px;
  min-height: 0;

  margin: 0;
  overflow: hidden;
  background: #111;
}


  #HeroMedia-{{ section.id }} *,
  #HeroMedia-{{ section.id }} *::before,
  #HeroMedia-{{ section.id }} *::after {
    box-sizing: border-box;
  }



  /* ============================================================
     HERO WRAPPER
  ============================================================ */

  #HeroMedia-{{ section.id }} .hero-media-section__inner {
    position: relative;

    width: 100%;

    min-height: 760px;

    margin: 0;

    overflow: hidden;

    background: #111;
  }



  /* ============================================================
     VIDEO
  ============================================================ */

  #HeroMedia-{{ section.id }} .hero-media-section__video {
    position: absolute;

    inset: 0;

    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    object-position: center center;
  }



  /* ============================================================
     IMAGE FALLBACK
  ============================================================ */

  #HeroMedia-{{ section.id }} .hero-media-section__image {
    position: absolute;

    inset: 0;

    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    object-position: center center;
  }



  /* ============================================================
     DARK OVERLAY
  ============================================================ */

  #HeroMedia-{{ section.id }} .hero-media-section__overlay {
    position: absolute;

    inset: 0;

    z-index: 1;

    pointer-events: none;

    background:
      linear-gradient(
        to top,
        rgba(0, 0, 0, 0.58) 0%,
        rgba(0, 0, 0, 0.28) 38%,
        rgba(0, 0, 0, 0.08) 68%,
        rgba(0, 0, 0, 0) 100%
      );
  }



  /* ============================================================
     CONTENT
  ============================================================ */

  #HeroMedia-{{ section.id }} .hero-media-section__content {
    position: absolute;

    left: max(
      32px,
      calc((100vw - 1400px) / 2 + 32px)
    );

    right: 32px;

    bottom: 58px;

    z-index: 2;

    max-width: 800px;

    color: #fff;

    text-align: left;
  }



  /* ============================================================
     HEADING
  ============================================================ */

  #HeroMedia-{{ section.id }} .hero-media-section__heading {
    max-width: 760px;

    margin: 0 0 14px;

    color: #fff;

    font-size: clamp(
      46px,
      4.8vw,
      72px
    );

    line-height: 0.98;

    font-weight: 700;

    letter-spacing: -0.04em;
  }



  /* ============================================================
     TEXT
  ============================================================ */

  #HeroMedia-{{ section.id }} .hero-media-section__text {
    max-width: 720px;

    margin: 0 0 22px;

    color: #fff;

    font-size: 18px;

    line-height: 1.45;
  }



  /* ============================================================
     BUTTON
  ============================================================ */

  #HeroMedia-{{ section.id }} .hero-media-section__button {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-height: 48px;

    padding: 12px 25px;

    border: 1px solid #fff;

    background: #fff;

    color: #111;

    font-size: 14px;

    line-height: 1;

    font-weight: 500;

    text-decoration: none;

    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      opacity 0.2s ease;
  }


  #HeroMedia-{{ section.id }} .hero-media-section__button:hover {
    background: #111;

    border-color: #111;

    color: #fff;
  }



  /* ============================================================
     TABLET
  ============================================================ */

  @media screen and (max-width: 140px) {

    #HeroMedia-{{ section.id }} .hero-media-section__inner {
      min-height: 680px;
    }


    #HeroMedia-{{ section.id }} .hero-media-section__content {
      left: 30px;

      right: 30px;

      bottom: 40px;

      max-width: 650px;
    }


    #HeroMedia-{{ section.id }} .hero-media-section__heading {
      max-width: 620px;

      font-size: 48px;
    }


    #HeroMedia-{{ section.id }} .hero-media-section__text {
      max-width: 620px;

      font-size: 17px;
    }

  }



  /* ============================================================
     MOBILE
  ============================================================ */

  @media screen and (max-width: 749px) {

    #HeroMedia-{{ section.id }} .hero-media-section__inner {
      min-height: 620px;
    }


    #HeroMedia-{{ section.id }} .hero-media-section__video,
    #HeroMedia-{{ section.id }} .hero-media-section__image {
      object-position: 58% center;
    }


    #HeroMedia-{{ section.id }} .hero-media-section__overlay {
      background:
        linear-gradient(
          to top,
          rgba(0, 0, 0, 0.72) 0%,
          rgba(0, 0, 0, 0.42) 42%,
          rgba(0, 0, 0, 0.10) 72%,
          rgba(0, 0, 0, 0) 100%
        );
    }


    #HeroMedia-{{ section.id }} .hero-media-section__content {
      left: 20px;

      right: 20px;

      bottom: 24px;

      max-width: none;
    }


    #HeroMedia-{{ section.id }} .hero-media-section__heading {
      max-width: 360px;

      margin-bottom: 12px;

      font-size: 36px;

      line-height: 1;

      letter-spacing: -0.035em;
    }


    #HeroMedia-{{ section.id }} .hero-media-section__text {
      max-width: 360px;

      margin-bottom: 20px;

      font-size: 15px;

      line-height: 1.45;
    }


    #HeroMedia-{{ section.id }} .hero-media-section__button {
      min-height: 45px;

      padding: 11px 21px;

      font-size: 14px;
    }

  }



  /* ============================================================
     SMALL MOBILE
  ============================================================ */

  @media screen and (max-width: 390px) {

    #HeroMedia-{{ section.id }} .hero-media-section__inner {
      min-height: 580px;
    }


    #HeroMedia-{{ section.id }} .hero-media-section__content {
      left: 16px;

      right: 16px;

      bottom: 18px;
    }


    #HeroMedia-{{ section.id }} .hero-media-section__heading {
      max-width: 320px;

      font-size: 31px;
    }


    #HeroMedia-{{ section.id }} .hero-media-section__text {
      max-width: 320px;

      font-size: 14px;
    }

  }

</style>


{% schema %}
{
  "name": "Hero video",

  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "image_picker",
      "id": "image_picker",
      "label": "Fallback image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "These styles are not coming back"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Last chance to shop our summer styles: Secure your favorites before they’re gone for good."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],

  "presets": [
    {
      "name": "Hero video"
    }
  ]
}
{% endschema %}